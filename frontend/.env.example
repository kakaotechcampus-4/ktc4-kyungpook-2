# 이 파일을 .env 로 복사해서 쓰세요 (.env 는 gitignore 됩니다).
#   copy .env.example .env
#
# VITE_* 는 빌드 시점에 번들에 박힙니다. 값을 바꾸면 dev 서버를 다시 시작해야 합니다.

# ── mock 플래그 ─────────────────────────────────────
# 데이터(대시보드·아이 목록·게이트…). 백엔드에 아직 대부분 열려 있지 않아 true 가 기본입니다.
VITE_USE_MOCK=true

# 로그인만 따로 켭니다. 데이터와 분리돼 있어서 "로그인은 실제, 나머지는 mock" 이 됩니다.
#   false → 실제 카카오 로그인
#   true  → 로그인 없이 "mock 데이터로 둘러보기" 버튼으로 화면 확인
VITE_AUTH_MOCK=true

# ── 로그인 진입 주소 ────────────────────────────────
# 로그인은 백엔드가 전부 처리합니다. 프론트에는 카카오 키가 필요 없습니다
# (client_id·client_secret 모두 백엔드만 가집니다).
#
# 운영: 비워 둡니다 — nginx 가 같은 오리진의 /oauth2/ 를 백엔드로 넘깁니다.
# 로컬: http://localhost:8080 이 필요합니다. Spring 이 자기가 받은 주소로
#       redirect_uri 를 조립하는데, Vite 프록시를 거치면 그 값이 카카오 콘솔
#       등록값과 어긋나 KOE006 이 납니다.
VITE_AUTH_ORIGIN=http://localhost:8080

# ── API 주소 ────────────────────────────────────────
# dev 는 vite proxy, 운영은 nginx 가 같은 오리진의 /api 를 넘기므로 비워 둡니다.
VITE_API_BASE_URL=
