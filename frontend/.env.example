# 이 파일을 .env 로 복사해서 쓰세요 (.env 는 gitignore 됩니다).
#   copy .env.example .env
#
# VITE_* 는 빌드 시점에 번들에 박힙니다. 값을 바꾸면 dev 서버를 다시 시작해야 합니다.

# ── mock 플래그 ─────────────────────────────────────
# 데이터(대시보드·아이 목록·게이트…). BE 에 아직 대부분 열려 있지 않아 true 가 기본입니다.
VITE_USE_MOCK=true

# 로그인만 따로 켭니다. 데이터와 분리돼 있어서 "로그인은 실제, 나머지는 mock" 이 됩니다.
#   false → 실제 카카오 로그인 (아래 키가 필요)
#   true  → 로그인 없이 mock 역할로 화면 둘러보기
VITE_AUTH_MOCK=false

# ── 카카오 ──────────────────────────────────────────
# 카카오 개발자 콘솔 > 앱 설정 > 앱 키 > REST API 키
VITE_KAKAO_CLIENT_ID=

# 콘솔의 [카카오 로그인 > Redirect URI] 와 BE 의 kakao.redirect-uri 셋이
# 글자까지 같아야 합니다. 다르면 카카오가 KOE006 으로 거절합니다.
VITE_KAKAO_REDIRECT_URI=http://localhost:3000/oauth/kakao/callback

# ── API 주소 ────────────────────────────────────────
# dev 는 vite proxy, 운영은 nginx 가 같은 오리진의 /api 를 넘기므로 비워 둡니다.
VITE_API_BASE_URL=
