# Spring Boot 서비스 레이어 주소.
# 로컬:   http://localhost:8080
# compose: http://backend:8080  (같은 네트워크의 서비스명)
API_BASE_URL=http://localhost:8080

# 브라우저에서 직접 호출할 때만 사용. 서버 컴포넌트는 API_BASE_URL 을 쓴다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# mock 데이터로 화면을 돌릴지 여부. 백엔드 엔드포인트가 생기면 false.
NEXT_PUBLIC_USE_MOCK=true
