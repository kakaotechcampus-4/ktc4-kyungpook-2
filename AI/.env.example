# LLM 접속. 키는 하나를 네 에이전트가 같이 쓴다.
API_KEY=

# 에이전트마다 주소·모델·JSON 강제를 따로 둔다.
#   _API_URL   엔드포인트 base 만 (/v1/chat/completions 는 코드가 붙인다). 필수
#   _MODEL     없으면 common/luna.py DEFAULT_MODEL (gpt-6-luna)
#   _JSON_MODE JSON 강제(response_format). 없으면 on. claude 계열은 400 으로 거절하니 off
# 모델 비교 결과(evals/scripts/real/MODEL_COMPARE.md): 매칭·검증은 루나, 요약·인사이트는 sonnet
MATCHING_API_URL=
MATCHING_MODEL=gpt-6-luna
MATCHING_JSON_MODE=on

VALIDATION_API_URL=
VALIDATION_MODEL=gpt-6-luna
VALIDATION_JSON_MODE=on

SUMMARY_API_URL=
SUMMARY_MODEL=claude-sonnet-5-5
SUMMARY_JSON_MODE=off

INSIGHT_API_URL=
INSIGHT_MODEL=claude-sonnet-5-5
INSIGHT_JSON_MODE=off

# ── 모델 비교 실험용 (evals/scripts/real/run_compare.sh 만 읽는다. 키는 API_KEY 를 같이 쓴다. 네 에이전트 모두 이 모델로 돌린다) ──
# COMPARE_<이름>_URL=https://<엔드포인트>/v1/chat/completions
# COMPARE_<이름>_MODEL=<모델 ID>
# COMPARE_<이름>_JSON=on|off
# COMPARE_SMOKE_CHILD=<사전 검증에 쓸 아동 가명 한 명. 없으면 4월 전체>
