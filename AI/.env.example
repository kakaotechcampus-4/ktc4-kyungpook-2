# Luna (OpenAI 호환) — 엔드포인트 base 만 넣습니다.
# /v1/chat/completions 경로는 코드가 붙입니다.
LUNA_API_URL=
LUNA_API_KEY=
# 모델 (없으면 common/luna.py DEFAULT_MODEL)
# LUNA_MODEL=gpt-6-luna
# JSON 강제(response_format). 모델이 400 으로 거절하면 off (예: claude 계열). 없으면 on
# LUNA_JSON_MODE=on

# ── 모델 비교 실험용 (evals/scripts/real/run_compare.sh 만 읽는다. 키는 LUNA_API_KEY 를 같이 쓴다) ──
# COMPARE_<이름>_URL=https://<엔드포인트>/v1/chat/completions
# COMPARE_<이름>_MODEL=<모델 ID>
# COMPARE_<이름>_JSON=on|off
# COMPARE_SMOKE_CHILD=<사전 검증에 쓸 아동 가명 한 명. 없으면 4월 전체>
