kakao:
  client-id: YOUR_KAKAO_REST_API_KEY
  client-secret: YOUR_KAKAO_CLIENT_SECRET
  # TODO: 프론트엔드 카카오 콜백 페이지 경로가 확정되면 값을 갱신한다.
  # 백엔드는 GET 콜백 라우트가 없고, 프론트가 인가 코드를 받아 POST /api/v1/auth/kakao 로 전달하는 구조다.
  redirect-uri: http://localhost:3000/oauth/kakao/callback

jwt:
  secret: CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_BYTES
