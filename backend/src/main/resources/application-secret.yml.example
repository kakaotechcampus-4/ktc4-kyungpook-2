# 이 파일을 application-secret.yml 로 복사해서 쓰세요 (그쪽은 gitignore 됩니다).
#   cp application-secret.yml.example application-secret.yml
#
# 배포에서는 이 파일 대신 환경변수로 넣습니다. application.yml 이 아래 이름으로 읽습니다.
#   JWT_SECRET · KAKAO_CLIENT_ID · KAKAO_CLIENT_SECRET
#   AUTH_SUCCESS_REDIRECT · AUTH_FAILURE_REDIRECT · AUTH_COOKIE_SECURE

spring:
  security:
    oauth2:
      client:
        registration:
          kakao:
            # 카카오 개발자 콘솔 > 앱 설정 > 앱 키 > REST API 키
            client-id: YOUR_KAKAO_REST_API_KEY
            client-secret: YOUR_KAKAO_CLIENT_SECRET

jwt:
  secret: CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_BYTES

# ── 카카오 콘솔에 등록할 Redirect URI ──────────────────────────
# 이제 콜백을 백엔드가 직접 받습니다. 프론트 주소가 아닙니다.
#   로컬  http://localhost:8080/login/oauth2/code/kakao
#   운영  http://13.125.56.179/login/oauth2/code/kakao
# 이 경로는 Spring Security 가 제공하므로 컨트롤러를 만들 필요가 없습니다.
