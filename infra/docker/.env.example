POSTGRES_DB=ktc
POSTGRES_USER=ktc
POSTGRES_PASSWORD=replace-with-a-long-random-password

# 원본 파일 저장용 S3 버킷 — 환경마다 다를 수 있어 기본값 없이 명시한다.
RAW_STORAGE_S3_BUCKET=itda-raw-records-dev

# 브라우저가 백엔드를 부를 주소.
# nginx 가 같은 오리진의 /api 를 backend 로 넘기므로 비워 두면 된다.
# (별도 도메인으로 분리할 때만 값을 채운다)
PUBLIC_API_BASE_URL=

# 백엔드 엔드포인트가 열리면 false 로 바꾸고 프론트 이미지를 다시 빌드한다.
USE_MOCK=true
