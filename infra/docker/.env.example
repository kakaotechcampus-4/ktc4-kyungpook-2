POSTGRES_DB=itdadb
POSTGRES_USER=itda
POSTGRES_PASSWORD=replace-with-a-long-random-password

# CD가 성공하면 서버의 .env에 GHCR 이미지 digest를 기록한다.
# 로컬 빌드에서는 비워두면 기존 ktc-backend 이미지를 사용한다.
BACKEND_IMAGE=
# AI도 같다. 비워두면 기존 ktc-ai 이미지를 사용한다.
AI_IMAGE=

# 로컬은 HTTP. 운영은 https://iitda.duckdns.org와 AUTH_COOKIE_SECURE=true를 설정한다.
PUBLIC_ORIGIN=http://localhost
AUTH_COOKIE_SECURE=false
# 다른 프론트 오리진을 허용할 때만 쉼표로 나열한다. 비워 두면 PUBLIC_ORIGIN을 쓴다.
CORS_ALLOWED_ORIGINS=

# JWT 서명용 비밀키. 서버의 .env에는 충분히 긴 무작위 값으로 설정한다.
JWT_SECRET=replace-with-a-long-random-secret

# 카카오 OAuth 설정. 실제 서버 .env에만 카카오 개발자 콘솔의 값을 넣는다.
KAKAO_CLIENT_ID=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret

# 원본 파일 저장용 S3 버킷 — 환경마다 다를 수 있어 기본값 없이 명시한다.
RAW_STORAGE_S3_BUCKET=itda-raw-records-dev

# 브라우저가 백엔드를 부를 주소.
# Caddy가 같은 오리진의 /api를 backend로 넘기므로 비워 두면 된다.
# (별도 도메인으로 분리할 때만 값을 채운다)
PUBLIC_API_BASE_URL=

# 백엔드 엔드포인트가 열리면 false 로 바꾸고 프론트 이미지를 다시 빌드한다.
USE_MOCK=true

# 프론트 로그인(카카오 · /auth/me · 회원가입) mock. USE_MOCK(데이터)과 별개다.
# 실연동 환경에서는 false 로 두고 프론트 이미지를 다시 빌드한다.
# true 면 로그인 화면에 "mock 데이터로 둘러보기" 버튼이 나온다.
VITE_AUTH_MOCK=true
